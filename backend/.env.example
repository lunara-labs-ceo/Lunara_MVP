# Lunara Backend Configuration
# Copy this file to .env and fill in all values before running the backend.

# ── Encryption ────────────────────────────────────────────────────────────────
# Key used to encrypt user-uploaded BigQuery credentials stored on disk.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# ── GCP / Vertex AI ───────────────────────────────────────────────────────────
# Required for all AI agent features (chat, semantic, relationship, report).

# Your GCP project ID (the project where Vertex AI is enabled)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Vertex AI region — gemini-3-flash-preview is only available via "global"
GOOGLE_CLOUD_LOCATION=global

# Must be TRUE to route google-adk calls through Vertex AI instead of AI Studio
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Path to your GCP service account JSON key file (local dev only).
# The service account needs roles: roles/aiplatform.user
# In production (Render), use GOOGLE_APPLICATION_CREDENTIALS_JSON instead.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account-key.json

# ── GCP Credentials — Production (Render / CI) ────────────────────────────────
# Base64-encoded contents of the service account JSON key file.
# Generate with: base64 -i your-key.json | tr -d '\n'
# Set this in the Render dashboard, not in this file.
# GOOGLE_APPLICATION_CREDENTIALS_JSON=

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Optional ──────────────────────────────────────────────────────────────────
# Frontend URL for CORS (local dev)
FRONTEND_URL=http://localhost:3000
DEBUG=true
